# RecoverAI Environment Configuration Template (NO SECRETS)
# Copy this file to .env and provide your local configuration values.

# Backend Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database & Supabase Auth Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recoverai
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Provider Configuration
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key
AI_MODEL=gemini-1.5-pro

# Frontend Public Variables
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
